# Copy to .env and fill in before deploying. Never commit the real .env.

# --- core -------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-50+-character-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=juntechnology.com,www.juntechnology.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://juntechnology.com,https://www.juntechnology.com

# --- database ---------------------------------------------------------------
# Leave unset to use the bundled SQLite file (fine for small sites).
# DATABASE_URL=postgres://user:password@localhost:5432/juntech

# --- storage ----------------------------------------------------------------
# Uploaded images live here — must survive deploys and be writable by the app.
# DJANGO_MEDIA_ROOT=/var/www/juntech/media
DJANGO_MAX_UPLOAD_SIZE=8388608

# --- locale -----------------------------------------------------------------
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LANGUAGE_CODE=en-us

# --- email (contact form notifications) -------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@juntechnology.com
# Where new enquiries are emailed. Leave blank to only store them in the dashboard.
DJANGO_CONTACT_NOTIFY_EMAIL=hello@juntechnology.com

# --- https ------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO


//summa